generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  erkak
  ayol
}

enum EmploymentType {
  shtat
  gpx
}

enum ContractDurationType {
  muddatsiz
  muddatli
}

enum EmployeeStatus {
  ishlamoqda
  tatilda
  ishdan_boshagan
}

enum CalendarKind {
  holiday
  dayoff
  workday
}

enum UserRole {
  superadmin
  kadrlar
  buxgalter
  operator // журнал юритувчи (техник ёрдам ходими)
  rahbar // фақат кўриш ва ҳисобот
}

enum OrderType {
  ishga_qabul
  lavozim_otkazish
  tatil_berish
  ishdan_boshatish
  ragbatlantirish
}

model Department {
  id        String       @id @default(uuid())
  name      String
  code      String?
  parentId  String?      @map("parent_id")
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  positions Position[]
  employees Employee[]

  @@map("departments")
}

model Position {
  id           String     @id @default(uuid())
  title        String
  rankOrder    Int        @default(100) @map("rank_order")
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  baseSalary   Decimal    @default(0) @map("base_salary") @db.Decimal(14, 2)
  staffCount   Int        @default(1) @map("staff_count")
  employees    Employee[]

  @@map("positions")
}

model Employee {
  id                   String               @id @default(uuid())
  tabNumber            String               @unique @map("tab_number")
  firstName            String               @map("first_name")
  lastName             String               @map("last_name")
  middleName           String?              @map("middle_name")
  birthDate            DateTime?            @map("birth_date") @db.Date
  birthPlace           String?              @map("birth_place")
  gender               Gender?
  nationality          String?
  partyMembership      String?              @map("party_membership")
  // Т-2 маълумотномага автоматик тушадиган қўшимча маълумотлар
  educationLevel       String?              @map("education_level")
  foreignLanguages     String?              @map("foreign_languages")
  academicDegree       String?              @map("academic_degree")
  academicTitle        String?              @map("academic_title")
  militaryRank         String?              @map("military_rank")
  stateAwards          String?              @map("state_awards")
  deputyStatus         String?              @map("deputy_status")
  phone                String?
  addressResidential   String?              @map("address_residential")
  pinfl                String?              @db.VarChar(14)
  passportSeriesNumber String?              @map("passport_series_number")
  passportGivenDate    DateTime?            @map("passport_given_date") @db.Date
  passportGivenBy      String?              @map("passport_given_by")
  departmentId         String               @map("department_id")
  department           Department           @relation(fields: [departmentId], references: [id])
  positionId           String               @map("position_id")
  position             Position             @relation(fields: [positionId], references: [id])
  employmentType       EmploymentType       @default(shtat) @map("employment_type")
  hireDate             DateTime?            @map("hire_date") @db.Date
  contractNumber       String?              @map("contract_number")
  contractDate         DateTime?            @map("contract_date") @db.Date
  contractDurationType ContractDurationType @default(muddatsiz) @map("contract_duration_type")
  probationMonths      Int                  @default(0) @map("probation_months")
  salary               Decimal              @default(0) @db.Decimal(14, 2)
  annualLeaveBasicDays Int                  @default(21) @map("annual_leave_basic_days")
  annualLeaveExtraDays Int                  @default(6) @map("annual_leave_extra_days")
  photoUrl             String?              @map("photo_url")
  status               EmployeeStatus       @default(ishlamoqda)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  education          EmployeeEducation[]
  workHistory        EmployeeWorkHistory[]
  relatives          EmployeeRelative[]
  documents          EmployeeDocument[]
  orders             Order[]
  timesheets         Timesheet[]
  generatedDocuments GeneratedDocument[]

  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

model EmployeeEducation {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  institutionName String   @map("institution_name")
  speciality      String?
  studyType       String?  @map("study_type")
  startYear       Int?     @map("start_year")
  endYear         Int?     @map("end_year")

  @@map("employee_education")
}

model EmployeeWorkHistory {
  id               String    @id @default(uuid())
  employeeId       String    @map("employee_id")
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  organizationName String    @map("organization_name")
  positionTitle    String?   @map("position_title")

  @@map("employee_work_history")
}

model EmployeeRelative {
  id                String   @id @default(uuid())
  employeeId        String   @map("employee_id")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  relativeType      String   @map("relative_type")
  fullName          String   @map("full_name")
  birthYearPlace    String?  @map("birth_year_place")
  workPlacePosition String?  @map("work_place_position")
  livingAddress     String?  @map("living_address")

  @@map("employee_relatives")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType String   @map("document_type")
  filePath     String   @map("file_path")
  uploadDate   DateTime @default(now()) @map("upload_date")

  @@map("employee_documents")
}

model Order {
  id           String    @id @default(uuid())
  orderNumber  String    @map("order_number")
  orderDate    DateTime  @map("order_date") @db.Date
  orderType    OrderType @map("order_type")
  employeeId   String    @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  payloadJson  Json      @default("{}") @map("payload_json")
  docxFilePath String?   @map("docx_file_path")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("orders")
}

model Timesheet {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  daysData         Json     @default("{}") @map("days_data")
  totalWorkedDays  Int      @default(0) @map("total_worked_days")
  totalWorkedHours Int      @default(0) @map("total_worked_hours")
  calculatedSalary Decimal  @default(0) @map("calculated_salary") @db.Decimal(14, 2)

  @@unique([employeeId, year, month])
  @@map("timesheet")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model GeneratedDocument {
  id         String   @id @default(uuid())
  type       String
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  number     String?
  payload    Json     @default("{}")
  filePath   String   @map("file_path")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([employeeId, type])
  @@map("generated_documents")
}

model User {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(kadrlar)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  journalTickets   JournalTicket[]
  journalEntries   JournalEntry[]
  journalTrainings JournalTraining[]
  journalKb        JournalKb[]

  @@map("users")
}

model CalendarDay {
  date DateTime     @id @db.Date
  kind CalendarKind
  note String?

  @@map("calendar_days")
}

/// Тизимдаги ўзгартирувчи амаллар журнали (кимнинг, нима қилгани). Фойдаланувчи ўчирилса ҳам ёзув қолади — шунинг учун FK йўқ.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  userLogin String?  @map("user_login")
  userName  String?  @map("user_name")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   String?
  method    String
  path      String
  status    Int
  ip        String?

  @@index([createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

// ───────── Ижро журнали (техник ёрдам фаолияти) ─────────

/// Ташкилотлар ягона рўйхати; қолган журналлар шунга боғланади. nameKey — дубликатларни аниқлаш учун нормаллаштирилган ном.
model JournalOrg {
  id        String   @id @default(uuid())
  name      String
  nameKey   String   @unique @map("name_key")
  region    String   @default("")
  group     String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  tickets   JournalTicket[]
  entries   JournalEntry[]
  trainings JournalTraining[]

  @@map("journal_orgs")
}

/// Техник мурожаатлар — марказий ёзув. Холат қийматлари `journal.constants.ts` даги рўйхатдан (ўзгартириладиган).
model JournalTicket {
  id          String      @id @default(uuid())
  code        String      @unique
  received    DateTime    @db.Date
  orgId       String?     @map("org_id")
  org         JournalOrg? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  group       String      @default("")
  person      String      @default("")
  channel     String      @default("")
  category    String      @default("")
  priority    String      @default("")
  problem     String
  actions     String      @default("")
  dept        String      @default("")
  status      String      @default("Yangi")
  resolved    DateTime?   @db.Date
  replied     Boolean?
  note        String      @default("")
  createdById String?     @map("created_by_id")
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  entries   JournalEntry[]
  kb        JournalKb[]
  trainings JournalTraining[]

  @@index([received])
  @@index([status])
  @@index([orgId])
  @@map("journal_tickets")
}

/// Кундалик журнал: ҳар бир бажарилган иш. start/end — "HH:mm".
model JournalEntry {
  id          String         @id @default(uuid())
  date        DateTime       @db.Date
  start       String         @default("")
  end         String         @default("")
  type        String
  orgId       String?        @map("org_id")
  org         JournalOrg?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  ticketId    String?        @map("ticket_id")
  ticket      JournalTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  person      String         @default("")
  channel     String         @default("")
  content     String         @default("")
  done        String         @default("")
  result      String         @default("")
  status      String         @default("")
  next        String         @default("")
  partner     String         @default("")
  note        String         @default("")
  createdById String?        @map("created_by_id")
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([date])
  @@index([ticketId])
  @@index([orgId])
  @@map("journal_entries")
}

model JournalTraining {
  id          String         @id @default(uuid())
  date        DateTime       @db.Date
  orgId       String?        @map("org_id")
  org         JournalOrg?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  topic       String
  format      String         @default("")
  count       Int            @default(0)
  ticketId    String?        @map("ticket_id")
  ticket      JournalTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  link        String         @default("")
  trainer     String         @default("")
  result      String         @default("")
  note        String         @default("")
  createdById String?        @map("created_by_id")
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([date])
  @@index([orgId])
  @@map("journal_trainings")
}

model JournalKb {
  id          String         @id @default(uuid())
  code        String         @unique
  created     DateTime       @db.Date
  category    String         @default("")
  type        String         @default("")
  question    String
  solution    String         @default("")
  ticketId    String?        @map("ticket_id")
  ticket      JournalTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  link        String         @default("")
  version     String         @default("1.0")
  status      String         @default("Loyiha")
  review      DateTime?      @db.Date
  createdById String?        @map("created_by_id")
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([created])
  @@map("journal_kb")
}
