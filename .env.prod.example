# cp .env.prod.example .env.prod  — va qiymatlarni almashtiring
# Parol DATABASE_URL ichida ishlatiladi: faqat harf va raqam (masalan: openssl rand -hex 16)
POSTGRES_PASSWORD=ozgartiring-hex-parol
# Kamida 16 belgi, tasodifiy: openssl rand -hex 32
JWT_SECRET=ozgartiring-tasodifiy-uzun-kalit-123456
# HTTPS orqasida (reverse proxy / sertifikat) bo'lsa true qiling, aks holda cookie o'rnatilmaydi
COOKIE_SECURE=false
# Tashqi port
WEB_PORT=8080
# Faqat frontend boshqa domenda bo'lsa (odatda bo'sh qoldiriladi)
CORS_ORIGIN=

# HTTPS (Caddy) uchun domen: scripts/deploy.sh DOMAIN=... berilganda o'zi yozadi
# DOMAIN=hrms.example.uz
